{
  "name": "@xmov/walle",
  "private": false,
  "description": "瓦力 SDK TypeScript 实现",
  "version": "1.0.18",
  "author": {
    "name": "qindongxu",
    "email": "qindongxu@xmov.ai"
  },
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "default": "./index.ts"
    },
    "./src": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "walle",
    "sdk",
    "typescript",
    "video",
    "webcodecs",
    "webgl",
    "webrtc",
    "face-detection",
    "audio-processing"
  ],
  "scripts": {
    "build": "vite build",
    "build:dev": "vite build",
    "build:test": "vite build",
    "build:pre": "vite build",
    "build:innertest": "vite build",
    "build:prod": "vite build",
    "build:watch": "vite build --watch",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build && npm run typecheck",
    "release": "changeset version",
    "publish:ci": "changeset publish",
    "size": "size-limit",
    "analyze": "size-limit --why"
  },
  "dependencies": {
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.8",
    "@size-limit/preset-small-lib": "^11.1.6",
    "@types/node": "^20.1.4",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^2.1.6",
    "eslint": "^8.57.0",
    "jsdom": "^25.0.1",
    "rimraf": "^5.0.5",
    "size-limit": "^11.1.6",
    "tsup": "^8.3.5",
    "vite": "^5.4.8",
    "vite-plugin-dts": "^4.2.3",
    "typescript": "5.6.3",
    "vitest": "^2.1.6"
  },
  "peerDependencies": {
    "rxjs": "^7.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.xmov.ai",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://git.xmov.ai/frontend/star-cloud.git",
    "directory": "packages/walle"
  },
  "bugs": {
    "url": "https://git.xmov.ai/frontend/star-cloud/-/issues"
  },
  "homepage": "https://git.xmov.ai/frontend/star-cloud/-/tree/master/packages/walle#readme",
  "size-limit": [
    {
      "path": "dist/index.js",
      "limit": "50 KB"
    },
    {
      "path": "dist/index.mjs",
      "limit": "50 KB"
    }
  ]
}